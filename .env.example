# PostgreSQL — na Vercelu použij pooled connection string (Neon: host s "-pooler")
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Přímé (nepoolované) připojení pro migrace
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
# Podpis session JWT — vygeneruj: openssl rand -hex 32
AUTH_SECRET=""
# Veřejná URL aplikace (odkazy v e-mailech)
APP_URL="https://cookus.vercel.app"
# Volitelné: transakční e-maily přes Resend; bez klíče se e-maily logují
RESEND_API_KEY=""
MAIL_FROM="Cookus <noreply@cookus.cz>"
